// Cloudflare Worker config. Free plan only (CLAUDE.md rule 3).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deskstack",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Nightly SEC snapshot (scripts/build-snapshot.ts). Served before the Worker runs: free, no CPU.
  // run_worker_first: the Worker (not the public asset server) answers these paths, so the Damodaran
  // figures are only served through valuation_inputs, never as a bulk download (docs/DATA_SOURCES.md §8).
  "assets": { "directory": "./snapshot", "binding": "ASSETS", "run_worker_first": ["/v1/damodaran.json"] },
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    // SEC_USER_AGENT ("<app name> <contact email>", SEC fair-access policy) is a secret, never committed:
    //   printf '%s' "myapp me@example.com" | npx wrangler secret put SEC_USER_AGENT
    "DAILY_CAP": "90000",
    "PER_IP_PER_MINUTE": "60"
  },
  // Both guards are required on the shared service (security audit 2026-11-09, test/config.test.ts): without
  // them one client can spend the free plan's 100k requests/day for everyone.
  // Per-IP limit, per Cloudflare location (src/guard.ts allowIp). Without it, a per-isolate window is the fallback.
  "ratelimits": [{ "name": "IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }],
  // Global daily counter (src/guard.ts allowDaily; DAILY_CAP above). Self-hosting: `npx wrangler d1 create
  // deskstack-usage`, apply migrations/0001_usage.sql with --remote, and put your database_id here.
  "d1_databases": [{ "binding": "USAGE", "database_name": "deskstack-usage", "database_id": "cedde41f-7732-46d5-b886-2026541fd349" }],
  // Exact per-IP limit across isolates and locations (src/limiter.ts). Workers Free allows only SQLite-backed classes.
  "durable_objects": { "bindings": [{ "name": "IP_COUNTER", "class_name": "IpCounter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["IpCounter"] }]
}
