{
  "name": "deskstack-server",
  "version": "0.5.0",
  "description": "deskstack data layer: free, cited financial data for Claude (remote MCP server on Cloudflare Workers)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "snapshot": "tsx scripts/build-snapshot.ts",
    "snapshot:dev": "tsx scripts/build-snapshot.ts --tickers AAPL,MSFT,JPM,KO,CAT,GOOGL,SAP,TM",
    "check": "npm run typecheck && npm test && tsx scripts/build-snapshot.ts --fixtures test/fixtures/sec && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "damodaran": "tsx scripts/build-damodaran.ts",
    "bench": "tsx bench/run.ts"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261108.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.6",
    "@types/yauzl": "^3.4.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yauzl": "^3.4.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261104.1": true
  },
  "private": true
}
